{
  "name": "@dev4press/flyin",
  "version": "1.0.1",
  "description": "Modernized Flyin Popup Library",
  "type": "module",
  "main": "./dist/flyin.umd.js",
  "module": "./dist/flyin.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/flyin.es.js",
      "require": "./dist/flyin.umd.js"
    },
    "./flyin.css": "./dist/flyin.css"
  },
  "files": [
    "dist",
    "license.txt",
    "readme.md",
    "changelog.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dev4press/flyin.git"
  },
  "bugs": {
    "url": "https://github.com/dev4press/flyin/issues"
  },
  "homepage": "https://dev4press.github.io/flyin/",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.{ts,scss}\""
  },
  "keywords": [
    "popup",
    "animated",
    "typescript",
    "sass"
  ],
  "author": "Milan Petrovic",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^5.0.3"
  }
}
